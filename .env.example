# Banco MySQL/MariaDB da Hostinger
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO

# Segurança administrativa
AUTH_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_PASSWORD_HASH=$2a$12$gere_com_npm_run_hash_password
CRON_SECRET=troque-por-outra-chave-aleatoria

# Sistema de mídia / fonte principal dos produtos
MEDIA_API_URL=https://seu-sistema-de-midia.com
MEDIA_API_TOKEN=token-servidor-a-servidor

# Olist Tiny — contingência para custos que não vierem do sistema de mídia
TINY_API_BASE_URL=https://api.tiny.com.br/public-api/v3
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
TINY_REDIRECT_URI=https://seudominio.com.br/api/tiny/callback
TINY_TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Token estático legado/opcional. Prefira OAuth pelo painel.
TINY_ACCESS_TOKEN=

# URL pública do catálogo
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
